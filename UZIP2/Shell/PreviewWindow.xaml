<Window x:Class="UZIP2.Shell.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="包内预览" Height="520" Width="700" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Title_" Grid.Row="0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Status" Grid.Row="1" FontSize="12" Margin="0,2,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ListBox x:Name="Items" Grid.Row="2" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                  Click="OnItemCheck" Tag="{Binding}" />
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Width="20" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Width="300" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SizeText}" Width="90" Margin="8,0,0,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Method}" Width="110" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Content="全选" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="OnSelectAll" />
            <ui:Button Content="全不选" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="OnSelectNone" />
            <ui:Button Content="反选" FontSize="12" Padding="10,4" Margin="0,0,12,0" Click="OnInvert" />
            <ui:Button x:Name="ExtractBtn" Content="解压所选" Appearance="Primary" FontSize="12"
                       Padding="12,4" Margin="0,0,6,0" Click="OnExtractSelected" IsEnabled="False" />
            <ui:Button Content="全部解压" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                       Click="OnExtractAll" IsEnabled="False" x:Name="ExtractAllBtn" />
            <ui:Button Content="关闭" FontSize="12" Padding="10,4" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
