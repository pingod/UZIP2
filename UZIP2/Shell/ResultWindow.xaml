<Window x:Class="UZIP2.Shell.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="处理结果" Height="420" Width="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Summary" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ListView x:Name="Items" Grid.Row="1" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="操作" Width="60" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="结果" Width="70" DisplayMemberBinding="{Binding Outcome}" />
                    <GridViewColumn Header="说明 / 密码" Width="200" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button Grid.Row="2" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"
                Click="Close_Click" IsCancel="True" IsDefault="True" />
    </Grid>
</Window>
