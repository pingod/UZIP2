<Window x:Class="UZIP2.Shell.ChecksumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="校验和" Height="520" Width="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="SHA-256 用于比对下载页/发布说明里给出的哈希；旁边的 .sfv / .md5 / .sha256 校验文件会逐条核对（含同目录的分卷）。" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                               ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SHA-256" FontSize="11" VerticalAlignment="Top" Margin="0,1,8,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Sha256}" FontSize="12"
                                               FontFamily="Consolas" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Grid.Column="2" Content="复制" FontSize="12" Padding="8,2" Margin="8,0,0,0"
                                               Click="OnCopy" Tag="{Binding}"
                                               Visibility="{Binding HasHash, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Sidecars}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" Width="18"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Brush}" />
                                                <TextBlock Text="{Binding Text}" FontSize="12" Margin="4,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{Binding Brush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Error}" FontSize="12" Margin="0,6,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Grid.Column="1" Content="关闭" Appearance="Primary" IsCancel="True" IsDefault="True"
                       Click="OnClose" />
        </Grid>
    </Grid>
</Window>
