<UserControl x:Class="UZIP2.Shell.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:UZIP2.Shell.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="GroupName" Value="mode" />
        </Style>

        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>

        <DataTemplate x:Key="JobCard">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                    AutomationProperties.Name="{Binding DisplayName}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Archive24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="380" ToolTip="{Binding Archive}" />
                        <TextBlock Text="{Binding Kind}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusChip}">
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </Border.Resources>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="排队中" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                            <Setter Property="Text" Value="进行中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                            <Setter Property="Text" Value="完成" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Text" Value="失败" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Text" Value="已取消" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Grid>
                            <ProgressBar Height="6" Maximum="100"
                                         Value="{Binding Percent, FallbackValue=0}"
                                         Visibility="Visible">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <ui:ProgressRing Width="18" Height="18" HorizontalAlignment="Left"
                                             IsIndeterminate="True">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="ui:ProgressRing">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentFile}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}">
                                        <Binding Path="Done" />
                                        <Binding Path="Total" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Diagnosis}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Failed}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Queued,Running'}}" />
                        <ui:Button Content="预览" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.PreviewJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Kind, Converter={conv:EqualVisibility Extract}}" />
                        <ui:Button Content="重试" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Failed,Cancelled'}}" />
                        <ui:Button Content="打开目录" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Success}}" />
                        <ui:Button Content="校验" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.ChecksumJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Success,Failed'}}" />
                        <ui:Button Content="转格式" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.ConvertJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="解包后按工具条「转为」选定的格式重新打包（原包保留）"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Success,Failed'}}" />
                        <ui:Button Content="删除源文件" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Success}}" />
                        <ui:Button Content="移除" Appearance="Secondary" FontSize="12" Padding="10,4"
                                   Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="从列表移除这张卡片（记录仍可在历史页查到）"
                                   Visibility="{Binding IsTerminal, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:InfoBar Title="未找到 7-Zip" Severity="Error"
                        IsOpen="{Binding SevenZipMissing, Mode=OneWay}"
                        Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="解压/压缩需要 7z.exe。安装 7-Zip 或手动指定其目录。"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Content="选择 7-Zip 目录" Command="{Binding Locate7zCommand}" />
                </StackPanel>
            </ui:InfoBar>

            <ui:InfoBar Title="可更新" Severity="Success" IsClosable="False"
                        IsOpen="{Binding HasUpdate, Mode=OneWay}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Content="一键更新" Appearance="Primary" Command="{Binding ApplyUpdateCommand}"
                               Visibility="{Binding CanAutoUpdate, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="打开发布页" Margin="8,0,0,0" Command="{Binding OpenUpdatePageCommand}" />
                    <ui:Button Content="不再提示" Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}" />
                    <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:InfoBar>
        </StackPanel>

        <Border x:Name="DropCard" Grid.Row="1"
                Height="120" CornerRadius="10" Margin="0,0,0,14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="2" AllowDrop="True"
                PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
                PreviewDragEnter="OnDragEnter" PreviewDragLeave="OnDragLeave">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="将压缩包 / 文件 / 文件夹拖到此处" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding PreviewText}" Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                <RadioButton x:Name="RbAuto" Content="自动" Style="{StaticResource ModeRadio}"
                             IsChecked="True" Checked="OnModeChecked" Tag="0" />
                <RadioButton x:Name="RbExtract" Content="仅解压" Style="{StaticResource ModeRadio}"
                             Checked="OnModeChecked" Tag="1" />
                <RadioButton x:Name="RbCompress" Content="仅压缩" Style="{StaticResource ModeRadio}"
                             Checked="OnModeChecked" Tag="2" />
                <ui:Button Content="校验文件…" Appearance="Secondary" FontSize="12" Padding="10,4"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Command="{Binding BrowseChecksumCommand}"
                           ToolTip="计算 SHA-256，并核对同目录的 .sfv / .md5 / .sha256 校验文件" />
                <TextBlock Text="排序" Margin="16,0,6,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="SortBox" Width="104" FontSize="12" Padding="6,2" VerticalAlignment="Center"
                          ItemsSource="{Binding SortOptions}" SelectionChanged="OnSortChanged"
                          ToolTip="任务列表的排列方式（立即生效并记住）" />
                <TextBlock Text="转为" Margin="16,0,6,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="ConvertBox" Width="76" FontSize="12" Padding="6,2" VerticalAlignment="Center"
                          ItemsSource="{Binding ConvertTypeNames}" SelectedIndex="{Binding ConvertTypeIndex, Mode=TwoWay}"
                          ToolTip="任务卡片上「转格式」按钮的目标格式（bz2/gz/xz 只能装单个文件）" />
                <ui:Button Content="清除已完成" Appearance="Secondary" FontSize="12" Padding="10,4"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Command="{Binding ClearFinishedCommand}"
                           ToolTip="移除所有已完成/已取消的卡片（记录仍可在历史页查到）" />
                <ui:Button Content="全部取消" Appearance="Secondary" FontSize="12" Padding="10,4"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           Command="{Binding CancelAllJobsCommand}"
                           ToolTip="取消排队中和正在运行的全部任务" />
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="6" Padding="10,6" Margin="2,0,0,8"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="{Binding FailedCount, StringFormat={}{0} 个任务失败}" />
                    <ui:Button Content="重试全部失败" FontSize="12" Padding="10,4"
                               Command="{Binding RetryAllFailedCommand}" />
                    <ui:Button Content="导出失败报告" FontSize="12" Padding="10,4" Margin="6,0,0,0"
                               Command="{Binding ExportFailuresCommand}" />
                    <ui:Button Content="清除失败项" FontSize="12" Padding="10,4" Margin="6,0,0,0"
                               Command="{Binding ClearFailedCommand}"
                               ToolTip="从列表移除失败的卡片（记录仍可在历史页查到）" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource JobCard}" />
            </ScrollViewer>
            <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0"
                       FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="还没有任务：把压缩包 / 文件 / 文件夹拖到上方框中即可开始">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasJobs}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,10,0,0">
            <ui:Button Content="贴入剪切板密码" FontSize="12" Padding="10,4"
                       Command="{Binding PastePasswordCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="密码纸 " /><Run Text="{Binding PaperCount, Mode=OneWay}" /><Run Text=" / 200" />
            </TextBlock>
            <ui:SymbolIcon Symbol="Archive24" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"
                           ToolTip="7-Zip 路径"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Hyperlink Click="OnOpen7zLocation"><Run Text="7-Zip 设置" /></Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
