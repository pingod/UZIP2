<UserControl x:Class="UZIP2.Shell.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:UZIP2.Shell.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="GroupName" Value="mode" />
        </Style>

        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>

        <DataTemplate x:Key="JobCard">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Archive24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="380" ToolTip="{Binding Archive}" />
                        <TextBlock Text="{Binding Kind}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusChip}">
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </Border.Resources>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="排队中" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                            <Setter Property="Text" Value="进行中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                            <Setter Property="Text" Value="完成" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Text" Value="失败" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Text" Value="已取消" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Grid>
                            <ProgressBar Height="6" Maximum="100"
                                         Value="{Binding Percent, FallbackValue=0}"
                                         Visibility="Visible">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <ui:ProgressRing Width="18" Height="18" HorizontalAlignment="Left"
                                             IsIndeterminate="True">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="ui:ProgressRing">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentFile}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}">
                                        <Binding Path="Done" />
                                        <Binding Path="Total" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Diagnosis}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Failed}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Queued,Running'}}" />
                        <ui:Button Content="重试" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:AnyVisibility 'Failed,Cancelled'}}" />
                        <ui:Button Content="打开目录" Appearance="Secondary" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Success}}" />
                        <ui:Button Content="删除源文件" Appearance="Secondary" FontSize="12" Padding="10,4"
                                   Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding Status, Converter={conv:EqualVisibility Success}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0" Title="未找到 7-Zip" Severity="Error"
                    IsOpen="{Binding SevenZipMissing, Mode=OneWay}"
                    Margin="0,0,0,10">
            <ui:InfoBar.Content>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="解压/压缩需要 7z.exe。安装 7-Zip 或手动指定其目录。"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Content="选择 7-Zip 目录" Command="{Binding Locate7zCommand}" />
                </StackPanel>
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <Border x:Name="DropCard" Grid.Row="1"
                Height="120" CornerRadius="10" Margin="0,0,0,14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="2" AllowDrop="True"
                PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
                PreviewDragEnter="OnDragEnter" PreviewDragLeave="OnDragLeave">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="将压缩包 / 文件 / 文件夹拖到此处" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding PreviewText}" Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                <RadioButton x:Name="RbAuto" Content="自动" Style="{StaticResource ModeRadio}"
                             IsChecked="True" Checked="OnModeChecked" Tag="0" />
                <RadioButton x:Name="RbExtract" Content="仅解压" Style="{StaticResource ModeRadio}"
                             Checked="OnModeChecked" Tag="1" />
                <RadioButton x:Name="RbCompress" Content="仅压缩" Style="{StaticResource ModeRadio}"
                             Checked="OnModeChecked" Tag="2" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource JobCard}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
