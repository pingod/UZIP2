<UserControl x:Class="UZIP2.Shell.Pages.PasswordBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:UZIP2.Shell.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- 密码本工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="密码本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ui:TextBox x:Name="SearchBox" Width="220" PlaceholderText="搜索名称或密码…"
                            TextChanged="OnSearchChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Click="OnAddBook" Margin="0,0,8,0" />
                <ui:Button Content="从剪切板贴入" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                           Command="{Binding PasteFromClipboardCommand}" Margin="0,0,8,0" />
                <ui:Button Content="导出" Click="OnExportVault" Margin="0,0,8,0" ToolTip="用口令加密后导出，可跨机器导入" />
                <ui:Button Content="导入" Click="OnImportVault" ToolTip="从导出件合并密码" />
            </StackPanel>
        </Grid>

        <!-- 密码本列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BookList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding MaskedText}" VerticalAlignment="Center"
                                           FontFamily="Consolas" Margin="10,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Run Text="成功 " /><Run Text="{Binding SuccessCount, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <ui:Button Icon="{ui:SymbolIcon Eye24}" Padding="8,4" Margin="0,0,4,0"
                                               Click="OnReveal" ToolTip="显示密码 3 秒" />
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Padding="8,4" Margin="0,0,4,0"
                                               Click="OnEdit" ToolTip="编辑" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Padding="8,4"
                                               Click="OnDelete" ToolTip="删除" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 编辑弹层 -->
        <Border x:Name="EditOverlay" Grid.RowSpan="4" Panel.ZIndex="10"
                Background="#80000000" Visibility="Collapsed"
                MouseLeftButtonUp="OnOverlayClick">
            <Border Width="360" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseLeftButtonUp="OnOverlayBodyClick">
                <StackPanel>
                    <TextBlock x:Name="EditTitle" Text="添加密码" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ui:TextBox x:Name="EditName" PlaceholderText="名称（可空）" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="EditPlain" PlaceholderText="密码" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Click="OnEditCancel" Margin="0,0,8,0" />
                        <ui:Button Content="保存" Appearance="Primary" Click="OnEditSave" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 密码库口令弹层: 导出要确认两遍，导入只需一遍 -->
        <Border x:Name="VaultOverlay" Grid.RowSpan="4" Panel.ZIndex="11"
                Background="#80000000" Visibility="Collapsed"
                MouseLeftButtonUp="OnVaultOverlayClick">
            <Border Width="380" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseLeftButtonUp="OnOverlayBodyClick">
                <StackPanel>
                    <TextBlock x:Name="VaultTitle" Text="导出密码库" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="VaultHint" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="口令" FontSize="12" Margin="0,0,0,4" />
                    <PasswordBox x:Name="VaultPass1" Margin="0,0,0,10" />
                    <StackPanel x:Name="VaultConfirmRow">
                        <TextBlock Text="再输一遍口令" FontSize="12" Margin="0,0,0,4" />
                        <PasswordBox x:Name="VaultPass2" Margin="0,0,0,10" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Click="OnVaultCancel" Margin="0,0,8,0" />
                        <ui:Button x:Name="VaultAccept" Content="确定" Appearance="Primary" Click="OnVaultAccept" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 密码纸 -->
        <Grid Grid.Row="2" Margin="0,6,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="密码纸" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="{Binding PaperCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding PaperLimit, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="贴入剪切板" Click="OnPastePaper" Margin="0,0,8,0" />
                <ui:Button Content="清空" Click="OnClearPaper" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <ItemsControl ItemsSource="{Binding PaperRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12"
                                    Padding="10,4" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
