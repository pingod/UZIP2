<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>UZIP.ico</ApplicationIcon>
    <AssemblyName>UZIP2</AssemblyName>
    <RootNamespace>UZIP2</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <!-- 仅单文件发布时生效的瘦身开关：普通 build / 调试 / 测试不受影响 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- 只保留英文附属资源，去掉 WPF/BCL 的 30+ 语言资源 DLL -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 发布产物不带 pdb（调试用堆栈在单文件里本就无意义） -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 关掉 EnC 元数据更新支持，去掉 System.Reflection.Metadata 载荷 -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>
  <!-- 单文件内 deflate 压缩仅独立(self-contained)发布支持；框架依赖版不支持 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' AND '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 旧版界面/静态全局类整体归档，不参与编译 -->
    <Compile Remove="Legacy/**/*.cs" />
    <Page Remove="Legacy/**/*.xaml" />
    <None Include="Legacy/**" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="*.png" />
    <Content Include="App.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
