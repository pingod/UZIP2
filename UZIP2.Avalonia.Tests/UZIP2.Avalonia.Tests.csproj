<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia 壳的无头 UI 测试：不需要真实桌面，Linux/Windows 都能跑。 -->
  <!-- xunit v3：Avalonia.Headless.XUnit 12.x 只提供 v3 适配器，测试项目因此是 Exe 形态。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UZIP2.Avalonia/UZIP2.Avalonia.csproj" />
    <ProjectReference Include="../UZIP2.Core/UZIP2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
