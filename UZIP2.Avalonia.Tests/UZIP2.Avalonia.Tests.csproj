<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia 壳的无头 UI 测试：不需要真实桌面，Linux/Windows 都能跑。 -->
  <!-- xunit v3：Avalonia.Headless.XUnit 12.x 只提供 v3 适配器，测试项目因此是 Exe 形态。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 自带内进程 runner，产物是 Exe。 -->
    <OutputType>Exe</OutputType>
    <!-- 让 `dotnet test` 走 Microsoft.Testing.Platform 而不是 VSTest。
         走 VSTest 时 testhost.deps.json 里会引用 Newtonsoft.Json 13.0.3，而
         xunit v3 的依赖图里并没有这个包，CI 上直接报
         "An assembly specified in the application dependencies manifest
          (testhost.deps.json) was not found: package: 'Newtonsoft.Json'"
         然后 Test Run Aborted。MTP 模式用测试项目自己的入口点跑，不经过 testhost。 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UZIP2.Avalonia/UZIP2.Avalonia.csproj" />
    <ProjectReference Include="../UZIP2.Core/UZIP2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
