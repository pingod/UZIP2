<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UZIP2.Avalonia.Shell.MainWindow"
        Title="UZIP2" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="190,*">
    <Border Grid.Column="0" Background="#1B1B1F">
      <StackPanel Margin="12" Spacing="2">
        <TextBlock Text="UZIP" FontSize="22" FontWeight="SemiBold" Margin="8,10,8,18"/>
        <Button x:Name="NavHome" Content="主页" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Background="Transparent" BorderThickness="0" Padding="12,10" Click="OnNavHome"/>
        <Button x:Name="NavHistory" Content="历史" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Background="Transparent" BorderThickness="0" Padding="12,10" Click="OnNavHistory"/>
        <Button x:Name="NavSettings" Content="设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Background="Transparent" BorderThickness="0" Padding="12,10" Click="OnNavSettings"/>
      </StackPanel>
    </Border>
    <ContentControl Grid.Column="1" x:Name="PageHost" Margin="20"/>
  </Grid>
</Window>
