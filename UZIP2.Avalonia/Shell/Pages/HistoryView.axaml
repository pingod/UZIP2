<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:UZIP2.Avalonia.Shell.Pages"
             x:Class="UZIP2.Avalonia.Shell.Pages.HistoryView">
  <UserControl.Resources>
    <!-- 校验类记录没有"重跑"语义，对齐 WPF HistoryRow.CanRetry -->
    <pages:HistoryKindRetryableConverter x:Key="RetryAllowed" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <TextBox x:Name="SearchBox" Width="320" Watermark="按路径 / 状态过滤…" TextChanged="OnSearchChanged" />
      <Button Content="刷新" Click="OnRefresh" />
      <Button Content="清空历史" Click="OnClear" />
      <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="#8AB4F8" Opacity="0.9" />
    </StackPanel>

    <ListBox Grid.Row="1" x:Name="HistoryList" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="#1E1E24" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source}" TextTrimming="CharacterEllipsis"
                         FontWeight="SemiBold" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right">
                <TextBlock Text="{Binding Kind}" Opacity="0.45" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Opacity="0.8" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Timestamp, Converter={StaticResource UnixMs}}" Opacity="0.55"
                           VerticalAlignment="Center" />
                <Button Content="重跑" Margin="10,0,0,0" Click="OnRetry"
                        IsVisible="{Binding Kind, Converter={StaticResource RetryAllowed}}"
                        ToolTip.Tip="用记录的源和口令重新执行一次" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Opacity="0.55" FontSize="12"
                         Text="{Binding Error}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2" x:Name="CountText" Margin="2,8,0,0" Opacity="0.6" />
  </Grid>
</UserControl>
