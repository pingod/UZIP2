<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UZIP2.Avalonia.Shell.Pages.PasswordView">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="密码" FontSize="22" FontWeight="SemiBold" />

      <Border Background="#1E1E24" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="密码本" FontWeight="SemiBold" />
          <TextBlock Text="解压时会按成功次数优先尝试；口令以本机密钥加密存放。"
                     Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NameBox" Width="180" PlaceholderText="备注名" />
            <TextBox x:Name="PlainBox" Width="280" PlaceholderText="口令" PasswordChar="●" />
            <Button Content="添加" Click="OnAdd" />
            <Button x:Name="PasteButton" Content="从剪贴板粘贴" Click="OnPasteClipboard"
                    ToolTip.Tip="读取剪贴板里的文本，按行写入下面的密码纸" />
          </StackPanel>
          <ListBox x:Name="BookList" Background="Transparent" BorderThickness="0" MaxHeight="320">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#24242B" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="160,*,120,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding SuccessText}" Opacity="0.5" FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                      <Button Content="显示" Click="OnToggleReveal" />
                      <Button Content="复制" Click="OnCopy" />
                      <Button Content="删除" Click="OnRemove" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="BookCount" Opacity="0.5" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Background="#1E1E24" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="密码纸" FontWeight="SemiBold" />
          <TextBlock Text="一次性口令：命中后自动划掉。每行一个，也可以整段粘贴。"
                     Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
          <TextBox x:Name="PaperBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="每行一个口令" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="加入密码纸" Click="OnAddPaper" />
            <Button Content="清空" Click="OnClearPaper" />
            <TextBlock x:Name="PaperCount" VerticalAlignment="Center" Opacity="0.5" FontSize="12" />
          </StackPanel>
          <ListBox x:Name="PaperList" Background="Transparent" BorderThickness="0" MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Opacity="0.85" Padding="0,3" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- 操作回执：粘贴是否成功、读剪贴板失败原因 -->
      <TextBlock x:Name="HintText" Foreground="#8AB4F8" Opacity="0.9" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
