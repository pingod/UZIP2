<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UZIP2.Avalonia.Shell.DiffWindow"
        Title="包对比" Width="820" Height="560"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />
    <TextBox Grid.Row="1" x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" VerticalContentAlignment="Top" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="关闭" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
