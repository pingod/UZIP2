<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux 图形界面（Avalonia 11）。只引用跨平台核心；Windows 仍以 WPF 版为正式产物。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UZIP2.Avalonia</AssemblyName>
    <RootNamespace>UZIP2.Avalonia</RootNamespace>
    <Version>3.12.0</Version>
    <Deterministic>true</Deterministic>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- DPAPI 只在 Windows 分支实例化（见 AppHost），与 WPF 工程同一处理 -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- 无头 UI 测试要替换 X11HotkeyWatcher 的降级钩子（见该类说明） -->
  <ItemGroup>
    <InternalsVisibleTo Include="UZIP2.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UZIP2.Core\UZIP2.Core.csproj" />
  </ItemGroup>

</Project>
