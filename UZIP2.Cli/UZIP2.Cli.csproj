<Project Sdk="Microsoft.NET.Sdk">

  <!-- 无界面宿主：Linux 上真正能跑的那个 UZIP2（Windows 的 CLI 仍由 WPF 程序提供）。
       只引用跨平台核心，绝不含 WPF/WinForms。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UZIP2</AssemblyName>
    <RootNamespace>UZIP2.CliHost</RootNamespace>
    <Version>3.12.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' AND '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UZIP2.Core\UZIP2.Core.csproj" />
  </ItemGroup>

</Project>
