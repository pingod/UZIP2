# Maintainer: 无常 (pingod) <https://github.com/pingod>

# 源码包：从 tag 归档构建（需要 dotnet-sdk + 网络还原 NuGet）。
# 想跳过编译用 PKGBUILD-bin（直接装 Release 里的自包含二进制）。
pkgname=uzip2
pkgver=3.10.0
pkgrel=1
pkgdesc="UZIP2 — 7-Zip 前端（Linux 命令行版）"
arch=('x86_64' 'aarch64')
url="https://github.com/pingod/UZIP2"
license=('GPL-3.0-or-later')
depends=('7zip')
makedepends=('dotnet-sdk')
provides=('uzip2')
conflicts=('uzip2-bin')
# 单文件 .NET 包在 ELF 末尾追加了 bundle；strip/debug 会把它切坏
# （实测运行时报 "Arithmetic overflow while reading bundle"）
options=(!strip !debug)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "UZIP2-$pkgver"
  case "$CARCH" in
    x86_64)  _rid=linux-x64 ;;
    aarch64) _rid=linux-arm64 ;;
    *)       error "不支持的架构: $CARCH" ;;
  esac
  dotnet publish UZIP2.Cli/UZIP2.Cli.csproj \
    -c Release -r "$_rid" --self-contained true \
    -p:PublishSingleFile=true -o "$srcdir/out"
}

package() {
  install -Dm755 "$srcdir/out/UZIP2" "$pkgdir/usr/bin/uzip2"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
