# Maintainer: 无常 (pingod) <https://github.com/pingod>

# 二进制包：直接用 GitHub Release 里的自包含 tar.gz，不编译、不需要 dotnet-sdk。
# pkgver 与 tag 对应；发布新版本时同步改这里与 sha256。
pkgname=uzip2-bin
pkgver=3.10.0
pkgrel=1
pkgdesc="UZIP2 — 7-Zip 前端（Linux 命令行版，预编译）"
arch=('x86_64' 'aarch64')
url="https://github.com/pingod/UZIP2"
license=('GPL-3.0-or-later')
depends=('7zip' 'fontconfig' 'freetype2' 'libice' 'libsm')
provides=('uzip2')
conflicts=('uzip2')
# 单文件 .NET 包在 ELF 末尾追加了 bundle；strip/debug 会把它切坏
options=(!strip !debug)
case "$CARCH" in
  x86_64)  _arch=x64 ;;
  aarch64) _arch=arm64 ;;
  *)       _arch=x64 ;;
esac
source=("$pkgname-$pkgver-$_arch.tar.gz::$url/releases/download/v$pkgver/UZIP2-$pkgver-linux-$_arch.tar.gz")
# 首次发布后把 tar.gz 的 sha256 填进来（可以用 Release 附带的 .sha256 侧车核对）
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/UZIP2-$pkgver-linux-$_arch/UZIP2" "$pkgdir/usr/bin/uzip2"
}
