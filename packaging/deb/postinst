#!/bin/sh
# UZIP2 的 deb 安装后脚本。
#
# 只做「刷新桌面数据库」，绝不碰用户配置：
#   ~/.config/uzip2（配置 + 密码本）与 ~/.local/state/uzip2（日志）属于用户，
#   包的 postrm 也不会删它们（见 postrm 的说明）。
#
# 必须容错：update-desktop-database / gtk-update-icon-cache 在最小化系统
# （容器、服务器、没有 desktop-file-utils 的机器）上不存在，缺了不是安装失败。
set -e

# $1 = configure | abort-upgrade | abort-remove | abort-deconfigure
case "$1" in
    configure)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
